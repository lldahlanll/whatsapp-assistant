# WhatsApp Platform Environment Configuration
APP_NAME="whatsapp-platform"
APP_ENV="development"
DEBUG=true

# Session & Pairing Settings
SESSION_NAME="default_session"
PAIRING_METHOD="qr" # 'qr' or 'code'
PAIRING_PHONE_NUMBER="" # Required if PAIRING_METHOD="code", e.g. 628123456789

# Database Configuration
DATABASE_URL="sqlite+aiosqlite:///./storage/session.db"

# Zona waktu untuk kalender finance (hari ini, laporan bulanan, tanggal tampilan)
APP_TIMEZONE="Asia/Jakarta"

# Messaging & Commands
COMMAND_PREFIX="!"
LOG_LEVEL="INFO"

# REST API Configuration
API_ENABLED=true
API_HOST="0.0.0.0"
API_PORT=8077
API_KEY="" # Set a secret key to enable X-API-Key authentication, e.g. "my-secret-api-key"

# AI Multi-Provider API Keys (comma-separated for multiple keys per provider)
GEMINI_API_KEYS="" # e.g. "AIzaSy1...,AIzaSy2..."
GROQ_API_KEYS="" # e.g. "gsk_1...,gsk_2..."
OPENROUTER_API_KEYS="" # e.g. "sk-or-1...,sk-or-2..."

# 9router Self-Hosted LLM Router (OpenAI-compatible)
NINEROUTER_API_KEYS=""         # API key untuk 9router, e.g. "key1,key2"
NINEROUTER_BASE_URL=""         # e.g. "http://192.168.1.100:4000/v1"
NINEROUTER_MODEL_CHAT="chat-pool"    # Nama model virtual untuk chat intent
NINEROUTER_MODEL_TOOLS="tools-pool"  # Nama model virtual untuk tool calling intent
NINEROUTER_MODEL_VISION="vision-pool" # Nama model virtual untuk image/vision intent

# AI Behaviour Settings
AI_COOLDOWN_DEFAULT_SECONDS=60.0
AI_RATE_LIMIT_MAX_REQUESTS=5
AI_RATE_LIMIT_WINDOW_SECONDS=60.0
AI_CONTEXT_WINDOW_MESSAGES=20
AI_MAX_CONTEXT_CHARS=16000
AI_BOT_MENTION_NAME="" # Bot display name for group @mention detection, e.g. "Bot"
AI_DEFAULT_ENABLED=false # true = chat baru langsung dibalas AI. Default false: aktifkan per chat dengan !ai on
AI_ADMIN_JIDS="" # Nomor/JID admin yang boleh !ai on/off/reset/model/stats (comma-separated), e.g. "628123456789"
AI_HTTP_TIMEOUT_SECONDS=30.0
AI_VISION_ENABLED=true # Analisis gambar via model vision (intent "image")
AI_IMAGE_MAX_BYTES=5242880 # Batas ukuran gambar (byte), default 5 MB

# MikroTik REST API & Network AI Settings
MIKROTIK_ENABLED=false # Set to true to enable MikroTik integration
MIKROTIK_HOST="" # e.g. "192.168.88.1"
MIKROTIK_PORT=80 # 80 for HTTP / 443 for HTTPS (RouterOS www/www-ssl service)
MIKROTIK_USERNAME="" # e.g. "ai-readonly"
MIKROTIK_PASSWORD="" # e.g. "secure-password"
MIKROTIK_USE_SSL=false # Set to true if using HTTPS
MIKROTIK_VERIFY_SSL=false # Set to true if HTTPS has a valid trusted CA certificate
MIKROTIK_TIMEOUT=5.0 # Timeout in seconds per API request
NETWORK_ALLOWED_JIDS="" # Whitelist WhatsApp JIDs allowed to run network commands (comma-separated). Empty = all allowed. e.g. "628123456789@s.whatsapp.net,12036301234567890@g.us"
NETWORK_CACHE_TTL_SYSTEM=30 # System health cache TTL in seconds
NETWORK_CACHE_TTL_FIREWALL=60 # Firewall rules cache TTL in seconds
NETWORK_CACHE_TTL_ROUTES=30 # Routes cache TTL in seconds
NETWORK_CACHE_TTL_DHCP=15 # DHCP leases cache TTL in seconds

