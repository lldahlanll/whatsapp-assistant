# ═══════════════════════════════════════════════════════════
#   Multi-Provider API Keys
# ═══════════════════════════════════════════════════════════

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# Gemini (https://aistudio.google.com/apikey) — 2 akun beda untuk quota terpisah
GEMINI_API_KEY_1=AIzaSyXXXXXXXXXXXXXXXXXX
GEMINI_API_KEY_2=AIzaSyYYYYYYYYYYYYYYYYYY

# OpenRouter (https://openrouter.ai/keys) — 2 akun
OPENROUTER_API_KEY_1=sk-or-v1-xxxxxxxxxxxx
OPENROUTER_API_KEY_2=sk-or-v1-yyyyyyyyyyyy

# ═══════════════════════════════════════════════════════════
#   HTTP & Reliability
# ═══════════════════════════════════════════════════════════
REQUEST_TIMEOUT=60.0
MAX_RETRIES=2
RETRY_DELAY=1.5
CIRCUIT_BREAKER_DISABLE_DURATION=600

# ═══════════════════════════════════════════════════════════
#   Redis
# ═══════════════════════════════════════════════════════════
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ═══════════════════════════════════════════════════════════
#   Memory & Rate Limit
# ═══════════════════════════════════════════════════════════
MAX_HISTORY_MESSAGES=20
HISTORY_TTL_SECONDS=604800
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=10

# ═══════════════════════════════════════════════════════════
#   Bot
# ═══════════════════════════════════════════════════════════
BOT_NAME=MyAIBot
SESSION_NAME=mybot_session
LOG_LEVEL=INFO
HEALTH_PORT=8080